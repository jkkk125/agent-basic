  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "启动程序",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "加载历史记录",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ],
      "program": "${file}",
      "args": [
        "--session",
        "517ad9db-c52c-49fd-b573-b034dd03e7f6"
      ],
      "console": "integratedTerminal"
    }
  ]
}